# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Publisher password (optional, defaults to "shipfast")
PUBLISHER_PASSWORD=shipfast

# Session secret (required, must remain stable across deployments)
SESSION_SECRET=your-secure-session-secret-here

# Redis URL (required for persistent session storage)
REDIS_URL=redis://127.0.0.1:6379

# S3 Bucket (optional) — if set, pages, meta and users will be synced to S3
S3_BUCKET=your-bucket-name
# Optional region (defaults to AWS_REGION)
S3_REGION=us-east-1
# AWS credentials are read from environment (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
